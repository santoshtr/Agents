# Copy this file to `.env` and paste in your key.
#   cp .env.example .env
#
# Get a key at https://console.anthropic.com/settings/keys
# `.env` is gitignored, so your key will not be committed.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Only needed if your key is "identity-linked" - you'll know because requests
# fail with "anthropic-workspace-id is required". Find the ID in the Console
# under Settings -> Workspaces. Leave this commented out otherwise.
# ANTHROPIC_WORKSPACE_ID=wrkspc-your-workspace-id-here
